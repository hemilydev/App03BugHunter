<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBug"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/fundo_card"
    app:cardCornerRadius="12dp"
    app:strokeColor="@color/status_aberto"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imageBug"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@string/desc_icone_bug"
            android:src="@drawable/ic_bug_baixa"
            app:tint="@color/gravidade_baixa" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textCodigo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/verde_neon"
                    android:textStyle="bold"
                    tools:text="BUG-001" />

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/status_aberto"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="ABERTO" />

            </LinearLayout>

            <TextView
                android:id="@+id/textTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/texto_claro"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Botão de login não responde" />

            <TextView
                android:id="@+id/textModulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="Módulo: Login" />

            <TextView
                android:id="@+id/textGravidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/background_gravidade"
                android:textColor="@color/fundo_terminal"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Gravidade 2 · Baixa" />

            <TextView
                android:id="@+id/textDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/texto_secundario"
                android:textSize="13sp"
                tools:text="Ao tocar no botão entrar nada acontece e o app não mostra nenhuma mensagem." />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>